{
  "uid": "k6-load-tests",
  "title": "k6 Load Tests",
  "tags": ["k6", "performance"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "test_type",
        "label": "Test type",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{source=\"k6\"}, test_type)",
        "query": { "query": "label_values(k6_http_reqs_total{source=\"k6\"}, test_type)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 2
      },
      {
        "name": "testid",
        "label": "Test run",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{source=\"k6\",test_type=~\"$test_type\"}, testid)",
        "query": { "query": "label_values(k6_http_reqs_total{source=\"k6\",test_type=~\"$test_type\"}, testid)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(k6_http_reqs_total{source=\"k6\",test_type=~\"$test_type\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "requests/s", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "HTTP failure rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "avg(k6_http_req_failed_rate{source=\"k6\",test_type=~\"$test_type\",testid=~\"$testid\"})", "legendFormat": "failed", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "HTTP duration percentiles",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "k6_http_req_duration_p95{source=\"k6\",test_type=~\"$test_type\",testid=~\"$testid\"}", "legendFormat": "p95", "refId": "A" }, { "expr": "k6_http_req_duration_p99{source=\"k6\",test_type=~\"$test_type\",testid=~\"$testid\"}", "legendFormat": "p99", "refId": "B" }],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Check success rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "avg(k6_checks_rate{source=\"k6\",test_type=~\"$test_type\",testid=~\"$testid\"})", "legendFormat": "checks", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Active virtual users",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(k6_vus{source=\"k6\",test_type=~\"$test_type\",testid=~\"$testid\"})", "legendFormat": "VUs", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "Gateway request rate by traffic source",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (traffic_source) (rate(ticketing_app_http_server_requests_total{environment=\"local\",service=\"api-gateway\",route=\"/api/tickets\"}[$__rate_interval]))", "legendFormat": "{{traffic_source}}", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    }
  ]
}
