discovery.docker "applications" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "applications" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(api-gateway|identity|tickets|orders|payments|expiration)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }
}

loki.source.docker "applications" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.applications.targets
  forward_to       = [loki.process.applications.receiver]
  relabel_rules    = discovery.relabel.applications.rules
  refresh_interval = "5s"
}

loki.process "applications" {
  stage.static_labels {
    values = {
      environment = "local",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
